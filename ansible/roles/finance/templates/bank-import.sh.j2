#!/bin/bash
# Taeglicher Bank-Autoimport (Enable Banking -> Firefly).
# Der Importer verarbeitet ALLE JSON-Configs in {{ finance_install_path }}/import,
# also je eine pro Bank (Sparkasse, C24, ...) - hier ist nichts anzupassen.
# Das Secret liegt in der 0600-Datei import.curlcfg, nicht in argv/Logs.
set -o pipefail

LOG="/tmp/bank-import-last.log"

# --fail entfernt: wir wollen den echten HTTP-Status sehen (nicht nur "gescheitert").
# --request POST: der Autoimport-Endpoint akzeptiert NUR POST (GET -> 405).
# http_code + curl-Exitcode werden erfasst, der Body landet im LOG zur Diagnose.
start_ts=$(date +%s.%N)
http_code=$(curl -sS -o "$LOG" -w '%{http_code}' \
  --request POST --config "{{ finance_install_path }}/import.curlcfg")
rc=$?
dur=$(awk "BEGIN{printf \"%.3f\", $(date +%s.%N) - $start_ts}")

# Health-Metrik im Webhook festhalten (record_run schreibt in die State-Datei,
# die /metrics liest). Fehlschlag hier darf den Import nicht scheitern lassen.
record() {
  docker exec finance-webhook python /app/record_run.py \
    --job bank_import --status "$1" --duration "$dur" >/dev/null 2>&1 || true
}

if [ "$rc" -ne 0 ] || [ "$http_code" -ge 400 ]; then
  record failed
  # Deutungshilfe statt Raterei:
  #   rc!=0 / http_code 000 -> Importer nicht erreichbar (Container down?)
  #   4xx                   -> Autoimport-Secret falsch ODER Config fehlt in /import
  #   5xx                   -> Importer-Fehler, evtl. Enable-Banking-Reconsent (90 Tage)
  case "$http_code" in
    000) hint="Importer nicht erreichbar (Container down? Port 8081?)" ;;
    4*)  hint="Autoimport-Secret falsch ODER keine Config in /import" ;;
    5*)  hint="Importer-Fehler - evtl. Enable-Banking-Reconsent (90 Tage)" ;;
    *)   hint="unbekannter Fehler" ;;
  esac
  # ntfy steht auf deny-all: ohne Anmeldung kommt nichts an (403). Deshalb
  # ueber send_ntfy im Webhook, der die Publisher-Zugangsdaten hat.
  docker exec finance-webhook python -c '
import os, sys
from advisor import send_ntfy
send_ntfy(sys.argv[1], os.environ["NTFY_URL"], os.environ.get("NTFY_TOKEN", ""),
          os.environ.get("NTFY_USER", ""), os.environ.get("NTFY_PASSWORD", ""),
          title="Bank-Sync fehlgeschlagen")
' "Bank-Import fehlgeschlagen (rc=$rc, http=$http_code): $hint" >/dev/null 2>&1 || true
else
  record success
fi
