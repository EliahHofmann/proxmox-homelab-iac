services:
  firefly-db:
    image: mariadb:11
    container_name: firefly-db
    restart: unless-stopped
    environment:
      - MYSQL_RANDOM_ROOT_PASSWORD=yes
      - MYSQL_USER=firefly
      - MYSQL_PASSWORD={{ finance_db_password }}
      - MYSQL_DATABASE=firefly
    volumes:
      - {{ finance_db_data }}:/var/lib/mysql
    networks: [finance-net]

  firefly-iii:
    image: fireflyiii/core:version-6
    container_name: firefly-iii
    restart: unless-stopped
    depends_on: [firefly-db]
    environment:
      - APP_ENV=production
      - APP_KEY={{ firefly_app_key }}
      - TZ=Europe/Berlin
      - APP_URL=https://{{ finance_subdomain }}.{{ finance_domain }}
      - TRUSTED_PROXIES=**
      - DB_CONNECTION=mysql
      - DB_HOST=firefly-db
      - DB_PORT=3306
      - DB_DATABASE=firefly
      - DB_USERNAME=firefly
      - DB_PASSWORD={{ finance_db_password }}
      - DEFAULT_LANGUAGE=de_DE
      - DEFAULT_LOCALE=equal
    ports:
      - "{{ finance_host_ip }}:8080:8080"   # nur LAN, oeffentlich nur via Traefik
    volumes:
      - {{ finance_firefly_data }}:/var/www/html/storage/upload
    networks: [finance-net]

  firefly-importer:
    image: fireflyiii/data-importer:version-2   # Enable Banking erst ab v2.1.0
    container_name: firefly-importer
    restart: unless-stopped
    depends_on: [firefly-iii]
    environment:
      - FIREFLY_III_URL=http://firefly-iii:8080
      - FIREFLY_III_ACCESS_TOKEN={{ firefly_pat }}
      - ENABLE_BANKING_APP_ID={{ enable_banking_app_id }}
      # Wert ist der PFAD zur Datei, nicht der Key selbst: config/eb.php liest
      # env('ENABLE_BANKING_PRIVATE_KEY') und prueft per realpath, ob es eine
      # lesbare Datei ist -> dann file_get_contents. Die _FILE-Variante aus der
      # Doku wird NICHT gelesen (leer -> realpath('') -> CWD -> "Is a directory").
      - ENABLE_BANKING_PRIVATE_KEY={{ enable_banking_key_path }}
      - ENABLE_BANKING_IMPORT_IP_HEADER={{ enable_banking_ip_header }}
      # hinter Traefik: sonst baut der Importer eine http-Callback-URL
      # und Enable Banking lehnt den Redirect ab
      - TRUSTED_PROXIES=**
      - TZ=Europe/Berlin
      - CAN_POST_AUTOIMPORT=true
      - AUTO_IMPORT_SECRET={{ importer_autoimport_secret }}
      - IMPORT_DIR_ALLOWLIST=/import
    volumes:
      - {{ finance_install_path }}/import:/import
      # ganzes Verzeichnis mounten, nicht die Einzeldatei: sonst legt Docker
      # bei fehlender Host-Datei ein Verzeichnis an ihrer Stelle an (errno 21)
      - {{ finance_install_path }}/secrets:/secrets:ro
    ports:
      - "{{ finance_host_ip }}:8081:8080"   # nur LAN, fuer Ersteinrichtung
    networks: [finance-net]

  finance-webhook:
    build: ./webhook-src
    container_name: finance-webhook
    restart: unless-stopped
    depends_on: [firefly-iii]
    environment:
      - PAPERLESS_URL={{ finance_paperless_url }}
      - PAPERLESS_TOKEN={{ finance_paperless_token }}
      - OLLAMA_URL={{ finance_ollama_url }}
      - OLLAMA_MODEL={{ finance_ollama_model }}
      - OLLAMA_MODEL_ADVISOR={{ finance_ollama_model_advisor }}
      - FIREFLY_URL=http://firefly-iii:8080
      - FIREFLY_PAT={{ firefly_pat }}
      - NTFY_URL={{ finance_ntfy_url }}
      - NTFY_USER=publisher
      - NTFY_PASSWORD={{ ntfy_publisher_password }}
      - NTFY_TOKEN={{ ntfy_token }}
      # Monitoring: gemeinsame State-Dateien der Cron-Jobs + Log-Salt (kein Secret,
      # nur damit merchant_hash nicht rueckrechenbar ist). Siehe metrics.py/slog.py.
      - METRICS_STATE_DIR=/app/state
      - LOG_SALT={{ finance_log_salt }}
    volumes:
      # Cron-Jobs (docker exec) und der Webhook teilen sich diese State-Dateien;
      # /metrics liest sie beim Scrape. Auf dem Host persistent -> Counter
      # ueberleben einen Rebuild.
      - {{ finance_metrics_state }}:/app/state
    ports:
      - "{{ finance_host_ip }}:9000:9000"   # nur an LAN-IP binden (Prometheus scrapt via LAN)
    networks: [finance-net]

  finance-listener:
    build: ./webhook-src
    container_name: finance-listener
    restart: unless-stopped
    command: python /app/ntfy_listener.py
    environment:
      - FIREFLY_URL=http://firefly-iii:8080
      - FIREFLY_PAT={{ firefly_pat }}
      - NTFY_BASE=http://ntfy:80
      - NTFY_CMD_TOPIC={{ ntfy_cmd_topic }}
      - NTFY_CMD_URL=https://{{ ntfy_subdomain }}.{{ finance_domain }}/{{ ntfy_cmd_topic }}
      - NTFY_URL={{ finance_ntfy_url }}
      - NTFY_USER=publisher
      - NTFY_PASSWORD={{ ntfy_publisher_password }}
      - NTFY_READER_USER={{ ntfy_reader_user }}
      - NTFY_READER_PASSWORD={{ ntfy_reader_password }}
      - LOG_SALT={{ finance_log_salt }}
    depends_on: [ntfy, firefly-iii]
    networks: [finance-net]

  ntfy:
    image: binwiederhier/ntfy:latest
    container_name: ntfy
    restart: unless-stopped
    command: serve
    environment:
      - TZ=Europe/Berlin
    volumes:
      - {{ finance_install_path }}/ntfy:/var/cache/ntfy
      - {{ finance_install_path }}/ntfy-config/server.yml:/etc/ntfy/server.yml:ro
    ports:
      - "{{ finance_host_ip }}:8082:80"
    networks: [finance-net]

networks:
  finance-net:
    name: finance-net
