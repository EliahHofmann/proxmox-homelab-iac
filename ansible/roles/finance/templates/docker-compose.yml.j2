services:
  firefly-db:
    image: mariadb:11
    container_name: firefly-db
    restart: unless-stopped
    environment:
      - MYSQL_RANDOM_ROOT_PASSWORD=yes
      - MYSQL_USER=firefly
      - MYSQL_PASSWORD={{ finance_db_password }}
      - MYSQL_DATABASE=firefly
    volumes:
      - {{ finance_db_data }}:/var/lib/mysql
    networks: [finance-net]

  firefly-iii:
    image: fireflyiii/core:version-6
    container_name: firefly-iii
    restart: unless-stopped
    depends_on: [firefly-db]
    environment:
      - APP_ENV=production
      - APP_KEY={{ firefly_app_key }}
      - TZ=Europe/Berlin
      - APP_URL=https://{{ finance_subdomain }}.{{ finance_domain }}
      - TRUSTED_PROXIES=**
      - DB_CONNECTION=mysql
      - DB_HOST=firefly-db
      - DB_PORT=3306
      - DB_DATABASE=firefly
      - DB_USERNAME=firefly
      - DB_PASSWORD={{ finance_db_password }}
      - DEFAULT_LANGUAGE=de_DE
      - DEFAULT_LOCALE=equal
    ports:
      - "8080:8080"
    volumes:
      - {{ finance_firefly_data }}:/var/www/html/storage/upload
    networks: [finance-net]

  firefly-importer:
    image: fireflyiii/data-importer:version-1
    container_name: firefly-importer
    restart: unless-stopped
    depends_on: [firefly-iii]
    environment:
      - FIREFLY_III_URL=http://firefly-iii:8080
      - FIREFLY_III_ACCESS_TOKEN={{ firefly_pat }}
      - NORDIGEN_ID={{ gocardless_id }}
      - NORDIGEN_KEY={{ gocardless_key }}
      - TZ=Europe/Berlin
      - CAN_POST_AUTOIMPORT=true
      - AUTO_IMPORT_SECRET={{ importer_autoimport_secret }}
      - IMPORT_DIR_ALLOWLIST=/import
    volumes:
      - {{ finance_install_path }}/import:/import
    ports:
      - "{{ finance_host_ip }}:8081:8080"   # nur LAN, fuer Ersteinrichtung
    networks: [finance-net]

  finance-webhook:
    build: ./webhook-src
    container_name: finance-webhook
    restart: unless-stopped
    depends_on: [firefly-iii]
    environment:
      - PAPERLESS_URL={{ finance_paperless_url }}
      - PAPERLESS_TOKEN={{ finance_paperless_token }}
      - OLLAMA_URL={{ finance_ollama_url }}
      - OLLAMA_MODEL={{ finance_ollama_model }}
      - FIREFLY_URL=http://firefly-iii:8080
      - FIREFLY_PAT={{ firefly_pat }}
      - NTFY_URL={{ finance_ntfy_url }}
      - NTFY_TOKEN={{ ntfy_token }}
    ports:
      - "{{ finance_host_ip }}:9000:9000"   # nur an LAN-IP binden
    networks: [finance-net]

  ntfy:
    image: binwiederhier/ntfy:latest
    container_name: ntfy
    restart: unless-stopped
    command: serve
    environment:
      - NTFY_BASE_URL=http://{{ finance_host_ip }}:8082
    volumes:
      - {{ finance_install_path }}/ntfy:/var/cache/ntfy
    ports:
      - "{{ finance_host_ip }}:8082:80"
    networks: [finance-net]

networks:
  finance-net:
    name: finance-net
