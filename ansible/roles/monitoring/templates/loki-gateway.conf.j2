# Waechter vor Loki, verwaltet von Ansible (monitoring).
# Von aussen nur Log-Lieferungen mit Passwort; Lesen geht nur intern (Grafana).
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    # Kein Zugriffslog: es wuerde selbst wieder an Loki geschickt
    access_log off;
    client_max_body_size 16m;

    server {
        # Zertifikat von der Homelab-CA, Schluessel bleibt auf dem Host
        listen 8080 ssl;
        ssl_certificate /etc/nginx/tls/tls.pem;
        ssl_certificate_key /etc/nginx/tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        location = /loki/api/v1/push {
            limit_except POST { deny all; }
            auth_basic "loki";
            auth_basic_user_file /etc/nginx/loki/htpasswd;
            proxy_pass http://loki:3100;
        }

        location = /ready {
            proxy_pass http://loki:3100;
        }

        location / {
            return 403;
        }
    }
}
