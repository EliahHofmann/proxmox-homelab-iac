global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'homelab-nodes'
    static_configs:
      - targets:
        - 'node-exporter:9100'  # Der Sensor deiner Monitoring-VM selbst
{% for host in (groups.get('proxmox_all_lxc', []) + groups.get('proxmox_all_qemu', [])) %}
        - '{{ hostvars[host].ansible_host | default(host) }}:9100'
{% endfor %}

  - job_name: 'proxmox'
    metrics_path: /pve
    static_configs:
      - targets:
        - '{{ proxmox_ip }}'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: pve-exporter:9221

  # Finance Automation Health: /metrics des finance-webhook (Port 9000, nur LAN).
  # Ziel-IP dynamisch aus dem Proxmox-Inventory (Tag actualbudget) -> kein Hardcoding.
{% set finance_hosts = groups.get('tag_actualbudget', []) %}
{% if finance_hosts %}
  - job_name: 'finance-webhook'
    scrape_interval: 30s
    metrics_path: /metrics
    static_configs:
      - targets:
{% for host in finance_hosts %}
        - '{{ hostvars[host].ansible_host }}:9000'
{% endfor %}
{% endif %}