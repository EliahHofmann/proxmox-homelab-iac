services:
  # Proton hat kein natives IMAP -> Bridge uebersetzt fuer den Paperless-Mailimport.
  # Kein Port-Publish: nur der webserver-Container erreicht sie unter proton-bridge:1143.
  # WICHTIG: ganzes /root mounten (nicht nur .config/protonmail) -> sonst geht der
  # pass-Passwortspeicher (~/.password-store) + GPG (~/.gnupg) beim Neustart verloren
  # und die Bridge meldet "no supported password manager".
  # Erst-Login einmalig manuell (Container vorher stoppen):
  #   docker stop proton-bridge
  #   docker run --rm -it -v {{ paperless_proton_data }}:/root shenxn/protonmail-bridge init
  #   -> im CLI: login / <Proton-Adresse> / <Passwort> / <2FA>, dann: info (IMAP-PW), exit
  #   docker start proton-bridge
  proton-bridge:
    image: shenxn/protonmail-bridge:latest
    container_name: proton-bridge
    restart: unless-stopped
    environment:
      - NON_INTERACTIVE=1
    expose:
      - "1143"
      - "1025"
    volumes:
      - {{ paperless_proton_data }}:/root

  broker:
    image: docker.io/library/redis:8
    restart: unless-stopped
    volumes:
      - redisdata:/data
  db:
    image: docker.io/library/postgres:15
    restart: unless-stopped
    volumes:
      - dbdata:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: paperless
      POSTGRES_USER: paperless
      POSTGRES_PASSWORD: {{ PAPERLESS_DBPASS }}
  webserver:
    image: ghcr.io/paperless-ngx/paperless-ngx:{{ paperless_version }}
    restart: unless-stopped
    depends_on:
      - db
      - broker
      - proton-bridge
    ports:
      - "{{ paperless_port }}:8000"
    volumes:
      - {{ paperless_install_path }}/data:/usr/src/paperless/data
      - {{ paperless_install_path }}/media:/usr/src/paperless/media
      - {{ paperless_install_path }}/export:/usr/src/paperless/export
      - {{ paperless_install_path }}/consume:/usr/src/paperless/consume
      - {{ paperless_install_path }}/scripts:/usr/src/paperless/scripts
    environment:
      PAPERLESS_REDIS: redis://broker:6379
      PAPERLESS_DBENGINE: postgres
      PAPERLESS_DBHOST: db
      PAPERLESS_DBUSER: paperless
      PAPERLESS_DBPASS: {{ PAPERLESS_DBPASS }}
      PAPERLESS_DBPORT: 5432
      PAPERLESS_SECRET_KEY: {{ PAPERLESS_SECRET_KEY }}
      PAPERLESS_ADMIN_USER: {{ PAPERLESS_ADMIN_USER }}
      PAPERLESS_ADMIN_PASSWORD: {{ PAPERLESS_ADMIN_PASSWORD }}
      PAPERLESS_POST_CONSUME_SCRIPT: /usr/src/paperless/scripts/ai_tagger.py
      AI_TAGGER_TOKEN: {{ PAPERLESS_API_TOKEN }}
      PAPERLESS_URL: "https://paperless.eliahhofmann.de"
volumes:
  data:
  media:
  dbdata:
  redisdata: