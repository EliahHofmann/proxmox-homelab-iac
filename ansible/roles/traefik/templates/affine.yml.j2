http:
  routers:
    affine-router:
      rule: "Host(`{{ affine_subdomain }}.{{ domain_name }}`)"
      service: "affine-service"
      entryPoints: ["websecure"]
      
      tls:
        certResolver: cloudflare
        domains:
            - main: "{{ domain_name }}"
            sans:
                - "*.{{ domain_name }}"

  services:
    affine-service:
      loadBalancer:
        servers:
         - url: "http://{{ affine_internal_ip }}:{{ affine_internal_port }}"