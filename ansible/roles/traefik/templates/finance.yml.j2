http:
  routers:
    finance-router:
      rule: "Host(`{{ finance_subdomain }}.{{ domain_name }}`)"
      service: "finance-service"
      entryPoints: ["websecure"]

      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain_name }}"
            sans:
                - "*.{{ domain_name }}"

  services:
    finance-service:
      loadBalancer:
        servers:
         - url: "http://{{ finance_internal_ip }}:8080"
