http:
  routers:
    finance-router:
      rule: "Host(`{{ finance_subdomain }}.{{ domain_name }}`)"
      service: "finance-service"
      entryPoints: ["websecure"]

      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain_name }}"
            sans:
                - "*.{{ domain_name }}"

    # Enable Banking verlangt eine HTTPS-Redirect-URL (Production).
    # Bewusst NICHT im cloudflared-Ingress eintragen -> nur per LAN-DNS
    # (AdGuard-Rewrite auf die Traefik-IP) erreichbar. Zertifikat kommt
    # trotzdem via DNS-01, dafuer ist keine oeffentliche Erreichbarkeit noetig.
    importer-router:
      rule: "Host(`{{ importer_subdomain }}.{{ domain_name }}`)"
      service: "importer-service"
      entryPoints: ["websecure"]

      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain_name }}"
            sans:
                - "*.{{ domain_name }}"

  services:
    finance-service:
      loadBalancer:
        servers:
         - url: "http://{{ finance_internal_ip }}:8080"

    importer-service:
      loadBalancer:
        servers:
         - url: "http://{{ finance_internal_ip }}:8081"
