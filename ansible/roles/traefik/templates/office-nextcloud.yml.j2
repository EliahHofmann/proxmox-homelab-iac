http:
  routers:
    office-router:
      rule: "Host(`{{ office_subdomain }}.{{ domain_name }}`)"
      service: "office-service"
      entryPoints: ["websecure"]

      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ domain_name }}"
            sans:
                - "*.{{ domain_name }}"

  services:
    office-service:
      loadBalancer:
        servers:
          - url: "http://{{ office_internal_ip }}:{{ office_internal_port }}"