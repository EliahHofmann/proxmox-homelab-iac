services:
    vaultwarden:
        image: vaultwarden/server:1.37.4
        container_name: vaultwarden
        restart: always
        environment:
            - WEBSOCKET_ENABLED=true
            # Argon2-Hash enthaelt $, Compose wuerde ihn sonst als Variable lesen
            - ADMIN_TOKEN={{ ADMIN_TOKEN | replace('$', '$$') }}
        volumes:
            - ./vw-data:/data
        ports:
            - "8080:80"